{
  "manifest_version": 3,
  "name": "VocabMin Companion (Edge 版) - 智慧英文閱讀與單字隨選助手",
  "short_name": "VocabMin",
  "version": "1.0.0",
  "minimum_edge_version": "114.0.0.0",
  "description": "專為 Microsoft Edge 英文閱讀與內建 PDF 閱讀器設計的智慧隨選助手：即時單字釋義、發音、長難句 AI 語法結構解析、側邊欄常駐，一鍵同步收錄至 VocabMin 單字庫。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "VocabMin Companion (Microsoft Edge)"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
